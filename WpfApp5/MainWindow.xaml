<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="MainWindow" Height="492" Width="800">

    <Grid x:Name="MainGrid">
        <Grid x:Name="PBgrid">
            <StackPanel Orientation="Horizontal">
                
            <ProgressBar x:Name="GlobalProgressBar"
                         Width="350" 
                         Height="6" 
                         Foreground="LightSkyBlue"
                         Margin="220,5,10,0"
                         IsIndeterminate="False"
                         Value="0"
                         VerticalAlignment="Top" 
                         HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" >
                <ProgressBar.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.179"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </ProgressBar.RenderTransform>
            </ProgressBar>
                <TextBlock Text="Total sum: 0$" FontSize="15" x:Name="TotalSumDisplay"></TextBlock>

            </StackPanel>
        </Grid>
        <Frame x:Name="MainFrame" Source="Pages/MainPage.xaml" NavigationUIVisibility="Hidden"  Margin="0,10,-10,0" Navigated="MainFrame_Navigated" ></Frame>
    </Grid>
</Window>
