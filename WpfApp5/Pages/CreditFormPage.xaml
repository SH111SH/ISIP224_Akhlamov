<Page x:Class="WpfApp5.Pages.CreditFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreditFormPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Personal info" Margin="20,20,20,20" FontSize="30" HorizontalAlignment="Center"></TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBlock  Text="Fullname" Margin="40,20,0,0" FontSize="15"/>
                <TextBox x:Name="FullnameInput" Width="250" Height="20" Margin="10,20,20,0" TextChanged="TextChanged"/>
                <TextBlock Visibility="Hidden" x:Name="ErrorDisplay1" Text="Wrong format!" Foreground="Red" Margin="0,20,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock  Text="Email" Margin="40,20,0,0" FontSize="15" />
                <TextBox x:Name="EmailInput" Width="250" Height="20" Margin="35,20,20,0" TextChanged="TextChanged"/>
                <TextBlock Visibility="Hidden"   x:Name="ErrorDisplay2" Text="Wrong format!" Foreground="Red" Margin="0,20,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock  Text="Phone" Margin="40,20,0,0" FontSize="15"/>
                <TextBox x:Name="PhoneInput" Width="250" Height="20" Margin="28,20,20,0" TextChanged="TextChanged"/>
                <TextBlock Visibility="Hidden"  x:Name="ErrorDisplay3" Text="Wrong format!" Foreground="Red" Margin="0,20,0,0"/>
            </StackPanel>
            <Frame x:Name="ModelPageFrame"></Frame>
            <StackPanel Orientation="Horizontal">
                <Button Content="Done" x:Name="DoneButton" Background="Azure" Margin="280,20,20,20"  Width="70" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="-0.899,0.574" Click="NextButton_Click" IsEnabled="False"/>
                <Button Content="Previous" x:Name="FBackButton" Background="Azure"  Width="70" Height="30" RenderTransformOrigin="-0.899,0.574" Click="FBackButton_Click"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
