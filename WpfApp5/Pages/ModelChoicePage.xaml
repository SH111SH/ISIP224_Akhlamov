<Page x:Class="WpfApp5.Pages.ModelChoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ModelChoicePage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Choose car model" Margin="20,10,20,20" FontSize="20" Width="200"></TextBlock>
            <StackPanel>
                <RadioButton Content="Lada Granta" FontSize="20" Width="200"/>
                <RadioButton Content="Tenet T7" FontSize="20" Width="200"/>
                <RadioButton Content="Haval Jolion" FontSize="20" Width="200"/>
                <RadioButton Content="Lada Vesta" FontSize="20" Width="200"/>

            </StackPanel>

            <TextBlock Text="Choose the engine type" Margin="20,20,20,20" FontSize="20" Width="218"></TextBlock>

            <StackPanel>
                <RadioButton Content="Gasoline" FontSize="20" Width="200"/>
                <RadioButton Content="Dizel" FontSize="20" Width="200"/>
                <RadioButton Content="Gas" FontSize="20" Width="200"/>
                <RadioButton Content="Hyprid" FontSize="20" Width="200"/>
                <RadioButton Content="Electric" FontSize="20" Width="200"/>

            </StackPanel>

            <Frame x:Name="ModelPageFrame"></Frame>
            <StackPanel Orientation="Horizontal">
                <Button Content="Next" x:Name="NextButton" Margin="280,20,20,20"  Width="70" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="-0.899,0.574" Click="NextButton_Click"/>
                <Button Content="Previous" x:Name="BackButton"   Width="70" Height="30" RenderTransformOrigin="-0.899,0.574"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
