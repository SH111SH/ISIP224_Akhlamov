<Page x:Class="WpfApp5.Pages.CheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CheckPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Check" Width="82" FontSize="30" Margin="20,20,20,20"/>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text="Model" Width="200" FontSize="25"/>
                <TextBlock Text="Model" Width="303" FontSize="25"/>
                <TextBlock Text="Price" Width="236" FontSize="25"/>
                
                
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text="Engine Type" Width="201" FontSize="25"/>
                <TextBlock Text="Engine Type" Width="303" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text="Color" Width="204" FontSize="25"/>
                <TextBlock Text="Color" Width="298" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>

            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text= "Cruise control" Width="205" FontSize="25"/>
                <TextBlock Text= "No" Width="300" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text= "Climat control" Width="205" FontSize="25"/>
                <TextBlock Text= "No" Width="300" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text= "Tonirovka" Width="205" FontSize="25"/>
                <TextBlock Text= "No" Width="300" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text="Display" Width="205" FontSize="25"/>
                <TextBlock Text= "No" Width="300" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text="Nitro" Width="205" FontSize="25"/>
                <TextBlock Text= "No" Width="300" FontSize="25"/>
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="773">
                <TextBlock Text="Total:" Width="334" FontSize="25"/>
                
                <TextBlock Text="Price" Width="264" FontSize="25"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Next" x:Name="CNextButton" Margin="280,20,20,20"  Width="70" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="-0.899,0.574" Click="NextButton_Click"/>
                <Button Content="Previous" x:Name="CBackButton"   Width="70" Height="30" RenderTransformOrigin="-0.899,0.574" Click="FBackButton_Click"/>
            </StackPanel>



        </StackPanel>
    </Grid>
</Page>
