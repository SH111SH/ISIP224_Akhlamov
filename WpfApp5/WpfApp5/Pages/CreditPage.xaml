<Page x:Class="WpfApp5.Pages.CreditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreditPage">

    <Grid>
        <StackPanel>
                <TextBlock Text="Credit Options" FontSize="30" HorizontalAlignment="Center"></TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Down Payment " FontSize="20" Margin="10,10,10,10"></TextBlock>
                <Slider x:Name="DownPaymenSlider" Width="500" Height="19" IsSnapToTickEnabled="True" ValueChanged="DownPaymenSlider_ValueChanged" Minimum="0" Maximum="90"></Slider>
                <TextBlock x:Name="DownPaymentSliDerValueDisplay"  Text="0" FontSize="19" Margin="10,10,10,10"/>
                <TextBlock Text="%" FontSize="19" Margin="0,10,10,10"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Down Payment Sum:" Margin="10,0,10,10" />
                <TextBlock Text="0" x:Name="DownPaymentSumDisplay" Margin="0,0,10,10" />
                
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Payment Deadline " FontSize="20" Margin="10,10,10,10"></TextBlock>
                <Slider x:Name="PaymentDeadline" Width="500" Height="19" IsSnapToTickEnabled="True"  Minimum="12" Maximum="96" ValueChanged="PaymentDeadline_ValueChanged"></Slider>
                <TextBlock x:Name="PaymentDeadlineDisplay" Text="12" FontSize="19" Margin="10,10,10,10"/>
                <TextBlock Text="Mounths" FontSize="19" Margin="0,10,10,10"></TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
