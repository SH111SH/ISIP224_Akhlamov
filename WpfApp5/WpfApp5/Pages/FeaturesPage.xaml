<Page x:Class="WpfApp5.Pages.FeaturesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FeaturesPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Choose car color" Margin="20,10,20,10" FontSize="20" Width="200"></TextBlock>
            <StackPanel>
                <RadioButton Content="White" FontSize="20" Width="200"/>
                <RadioButton Content="Black" FontSize="20" Width="200"/>
                <RadioButton Content="Red" FontSize="20" Width="200"/>
                <RadioButton Content="Yellow" FontSize="20" Width="200"/>
                <RadioButton Content="Magenta" FontSize="20" Width="200"/>
                

            </StackPanel>

            <TextBlock Text="Features" Margin="20,10,20,20" FontSize="20" Width="218"></TextBlock>

            <StackPanel>
                <CheckBox Content="Cruise control" FontSize="20" Width="200"/>
                <CheckBox Content="Climat control" FontSize="20" Width="200"/>
                <CheckBox Content="Tonirovka" FontSize="20" Width="200"/>
                <CheckBox Content="Display" FontSize="20" Width="200"/>
                <CheckBox Content="Nitro" FontSize="20" Width="200"/>

            </StackPanel>

            <Frame x:Name="ModelPageFrame"></Frame>
            <StackPanel Orientation="Horizontal">
                <Button Content="Next" x:Name="FNextButton" Margin="280,20,20,20"  Width="70" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="-0.899,0.574" Click="NextButton_Click"/>
                <Button Content="Previous" x:Name="FBackButton"   Width="70" Height="30" RenderTransformOrigin="-0.899,0.574" Click="FBackButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
