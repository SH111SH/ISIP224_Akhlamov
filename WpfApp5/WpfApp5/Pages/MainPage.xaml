<Page x:Class="WpfApp5.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Car Configurator" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="45"/>
            <Button x:Name="ModelButton" Content="Choose model and engine type" Width="200" Margin="50" Click="ModelButton_Click"></Button>


        </StackPanel>
    </Grid>
</Page>
